# ============================================================
# 前端 .dockerignore
# ============================================================

# --- 依赖（Node builder 会 npm ci 重装，不要把本地 node_modules 传 docker context）---
node_modules/
.pnp/
.pnp.js
.yarn/

# --- 构建产物（builder 会 npm run build 重打）---
dist/
build/
.output/
.nuxt/
.next/

# --- 版本控制 ---
.git/
.gitignore
.svn/

# --- IDE ---
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# --- 日志 ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
logs/

# --- 环境变量（本地 .env 可能含 localhost 配置，不要进镜像；生产用 docker-compose env）---
.env
.env.*
!.env.example   # .env.example 可以留

# --- 临时/系统 ---
.DS_Store
Thumbs.db
*.tmp
*.bak
*.pid
coverage/
test-results/
.vitest/
