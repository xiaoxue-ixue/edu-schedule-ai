<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spring Boot 官方推荐：logback-spring.xml（比 logback.xml 更晚加载，能读到 springProfile / springProperty）

  DEV profile：
    · 控制台彩色日志 + debug 级
    · 不写文件（本地磁盘没必要，控制台够调试）

  PROD profile：
    · 控制台仅 info 级（避免 stdout 把容器日志打爆）
    · 按天滚动写文件到 ./logs/edu-schedule-ai-%d{yyyy-MM-dd}.log
    · 单文件最大 100MB，保留 30 天历史，总大小不超过 10GB
    · 错误日志单独拆分到 -error.log，便于运维 grep

  2026-08-19 加固：
    · scan="false" → 消除两条 WARN：
        Missing watchable .xml or .properties files.
        Watching .xml files requires that the main configuration file is reachable as a URL.
      原因：打包进 JAR 后 logback-spring.xml 是 jar:nested URL，无法被 File 形式监听；
      生产环境也不允许热改日志配置，关闭完全安全。
-->
<configuration scan="false">
    <!-- ========= Spring Boot 彩色日志 & 异常堆栈转换规则 ========= -->
    <conversionRule conversionWord="clr" class="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wex" class="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>
    <conversionRule conversionWord="wEx" class="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter"/>

    <!-- ========= 通用属性 ========= -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="edu-schedule-ai"/>
    <property name="LOG_DIR"   value="./logs"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n"/>

    <!-- ========= 1. 控制台 Appender（所有环境都启用，但级别不同）========= -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %clr(%-5level) %clr(%logger{40}){cyan} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ========= 2. 文件滚动 Appender（仅 PROD 启用）========= -->
    <appender name="FILE_ALL" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${APP_NAME}-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ========= 3. 错误日志单独文件（仅 PROD 启用）========= -->
    <appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${APP_NAME}-error-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ========= DEV profile：控制台 debug ========= -->
    <springProfile name="dev">
        <logger name="com.edu.schedule" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ========= PROD profile：控制台 info + 文件滚动 ========= -->
    <springProfile name="prod">
        <logger name="com.edu.schedule" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE_ALL"/>
            <appender-ref ref="FILE_ERROR"/>
        </logger>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE_ALL"/>
            <appender-ref ref="FILE_ERROR"/>
        </root>
    </springProfile>

    <!-- ========= 兜底：其他未定义 profile（如 test）走 dev 风格 ========= -->
    <springProfile name="!dev &amp; !prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
